{
    "manifest_version": 2,
    "name": "chat-popup",
    "version": "3.0",

    

    "description": "Better chat windows!",

    "permissions": [
        "activeTab"
    ],

    "content_scripts": [
        {
            "matches": ["*://web.whatsapp.com/*"],
            "js": ["popup.js"]
        }
    ],

    "browser_specific_settings": {
        "gecko": {
        "id": "@chat-popup",
        "data_collection_permissions": {
            "required": ["none"]
        }
        }
    },

    "icons": {
        "48": "icon.svg"
    },

    "web_accessible_resources": [
        "icons/half.svg",
        "icons/full.svg"
    ]
}
