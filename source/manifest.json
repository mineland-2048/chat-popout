{
    "manifest_version": 2,
    "name": "chat-popup",
    "version": "2.1",

    "description": "Better chat windows!",

    "permissions": [
        "activeTab"
    ],

    "content_scripts": [
        {
            "matches": ["*://web.whatsapp.com/*", "*://127.0.0.1/*"],
            "js": ["popout.js"]
        }
    ],

    "icons": {
        "48": "icon.svg"
    },

    "web_accessible_resources": [
        "icons/half.svg",
        "icons/full.svg"
    ]
}
